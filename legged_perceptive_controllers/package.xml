<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>legged_perceptive_controllers</name>
    <version>0.0.0</version>
    <description>Perceptive legged controller: ros2_control plugin extending LeggedController with terrain receiver and
        foot-placement / sphere visualizations. Migrated to ROS2 ament_cmake.</description>
    <maintainer email="liaoqiayuan@gmail.com">Qiayuan Liao</maintainer>

    <license>BSD</license>
    <author email="liaoqiayuan@gmail.com">Qiayuan Liao</author>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>controller_interface</depend>
    <depend>pluginlib</depend>
    <depend>legged_perceptive_interface</depend>
    <depend>legged_controllers</depend>
    <depend>convex_plane_decomposition_msgs</depend>
    <depend>convex_plane_decomposition_ros</depend>
    <exec_depend>elevation_mapping_ros2</exec_depend>
    <depend>grid_map_ros</depend>
    <depend>grid_map_msgs</depend>
    <depend>grid_map_sdf</depend>
    <depend>visualization_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>std_msgs</depend>
    <depend>tf2_ros</depend>
    <depend>ocs2_ros_interfaces</depend>
    <depend>ocs2_sphere_approximation</depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
