<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>legged_perceptive_interface</name>
    <version>0.0.0</version>
    <description>Perceptive MPC interface (terrain-aware foot placement, foot/body collision via SDF) extending legged_interface. Migrated to ROS2 ament_cmake.</description>
    <maintainer email="liaoqiayuan@gmail.com">Qiayuan Liao</maintainer>

    <license>BSD</license>
    <author email="liaoqiayuan@gmail.com">Qiayuan Liao</author>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>legged_interface</depend>
    <depend>convex_plane_decomposition_msgs</depend>
    <depend>convex_plane_decomposition_ros</depend>
    <depend>grid_map_sdf</depend>
    <depend>ocs2_sphere_approximation</depend>
    <depend>pinocchio</depend>
    <depend>eigen</depend>
    <depend>libpcl-all-dev</depend>

    <test_depend>ament_cmake_gtest</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
